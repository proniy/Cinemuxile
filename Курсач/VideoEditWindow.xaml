<Window x:Class="Курсач.VideoEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Автоматический поиск видео" Height="800" Width="1200"
        WindowStartupLocation="Manual"
        Background="Transparent"
        WindowStyle="None"
        AllowsTransparency="True"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">
    <!-- Основной контейнер -->
    <Border x:Name="mainBorder" BorderBrush="#33FFCC" BorderThickness="2"  Background="#000010">
        <Grid Margin="0,8,0,0">
            <!-- Верхняя панель с заголовком и кнопками -->
            <DockPanel x:Name="dockPanelHeader" Height="40" VerticalAlignment="Top" Background="#000010"
                        MouseLeftButtonDown="TitleBar_MouseLeftButtonDown" Margin="10,10,10,0">
                <TextBlock x:Name="txtWindowTitle" Text="Автоматический поиск видео"
                           Foreground="#33FFCC"
                           FontSize="18"
                           VerticalAlignment="Center"
                           Margin="10 0 0 0"/>
                <!-- Кнопки окна -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="btnMinimize" Content="_"
                            Width="40"
                            Height="40"
                            Background="#000010"
                            Foreground="#33FFCC"
                            BorderBrush="#33FFCC"
                            BorderThickness="1"
                            FontSize="16"
                            Click="Minimize_Click"
                            Margin="0 0 5 0"
                            Padding="0"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"/>
                    <Button x:Name="btnClose" Content="X"
                            Width="40"
                            Height="40"
                            Background="#000010"
                            Foreground="#33FFCC"
                            BorderBrush="#33FFCC"
                            BorderThickness="1"
                            FontSize="16"
                            Click="Close_Click"
                            Padding="0"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"/>
                </StackPanel>
            </DockPanel>

            <!-- Основной контент -->
            <Grid Margin="0,40,0,0">
                <!-- Панель поиска -->
                <StackPanel Orientation="Horizontal" Height="97" VerticalAlignment="Top" Margin="10,0,10,0">
                    <TextBox x:Name="txtSearchQuery"
                             Width="300"
                             Background="#000010"
                             Foreground="#33FFCC"
                             BorderBrush="#33FFCC"
                             BorderThickness="1"
                             Padding="5"
                             Margin="0 0 5 0"
                             Tag="Введите название фильма"/>
                    <Button Content="Поиск"
                            Width="80"
                            Background="#000010"
                            Foreground="#33FFCC"
                            BorderBrush="#33FFCC"
                            BorderThickness="1"
                            Click="Search_Click"
                            Margin="5 0"
                            Padding="5"/>
                    <Button Content="Сохранить выбранные"
                            Width="150"
                            Background="#000010"
                            Foreground="#33FFCC"
                            BorderBrush="#33FFCC"
                            BorderThickness="1"
                            Click="SaveSelected_Click"
                            Margin="5 0"
                            Padding="5"/>
                </StackPanel>

                <!-- Результаты поиска -->
                <DataGrid x:Name="dgResults" Margin="10,100,10,10"
                          Background="#000010"
                          Foreground="#33FFCC"
                          BorderBrush="#33FFCC"
                          BorderThickness="1"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          SelectionMode="Extended"
                          HeadersVisibility="Column">
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#000010"/>
                            <Setter Property="Foreground" Value="#33FFCC"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="Background" Value="#000010"/>
                            <Setter Property="Foreground" Value="#33FFCC"/>
                            <Setter Property="BorderBrush" Value="#33FFCC"/>
                        </Style>
                    </DataGrid.CellStyle>
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Setter Property="Background" Value="#000010"/>
                            <Setter Property="Foreground" Value="#33FFCC"/>
                            <Setter Property="BorderBrush" Value="#33FFCC"/>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <!-- Колонка с мини-постером -->
                        <DataGridTemplateColumn Header="Постер" Width="80">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Image Source="{Binding posterUrl}"
                                           Width="70" Height="100"
                                           Stretch="UniformToFill"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="*"/>
                        <DataGridTextColumn Header="Год" Binding="{Binding year}" Width="80"/>
                        <DataGridTextColumn Header="Рейтинг" Binding="{Binding Rating1}" Width="80"/>
                        <DataGridTextColumn Header="Жанры" Binding="{Binding GenresString}" Width="150"/>
                        <DataGridTextColumn Header="Описание" Binding="{Binding description}" Width="200"/>
                        <DataGridTextColumn Header="Тип" Binding="{Binding type}" Width="100"/>
                        <DataGridTextColumn Header="Kinopoisk ID" Binding="{Binding filmId}" Width="120"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Grid>
    </Border>
</Window>