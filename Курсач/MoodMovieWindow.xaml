<Window x:Class="Курсач.MoodMovieWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Подбор фильма по настроению" Height="750" Width="850"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen">
    <Border x:Name="mainBorder" BorderThickness="2" CornerRadius="20" Padding="20">
        <Grid>
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock x:Name="titleText" Text="Интеллектуальный подбор кино" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20"/>
                
                <Border x:Name="questionsPanel" Visibility="Visible">
                    <StackPanel>
                        <TextBlock x:Name="questionText" Text="Загрузка вопроса..." FontSize="16" HorizontalAlignment="Center" Margin="0,0,0,20"/>
                        <WrapPanel x:Name="optionsPanel" HorizontalAlignment="Center" Margin="0,10"/>
                    </StackPanel>
                </Border>

                <Border x:Name="resultPanel" Visibility="Collapsed" HorizontalAlignment="Center">
                    <StackPanel Width="800">
                        <TextBlock x:Name="resultText" Text="Рекомендуемые фильмы:" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20"/>
                        <ScrollViewer MaxHeight="550" VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="moviesList">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <VirtualizingStackPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#1A1A2E" BorderBrush="#33FFCC" BorderThickness="1" CornerRadius="10" Margin="0,0,0,15" Padding="15">
                                            <Grid Width="750">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="150"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Image Source="{Binding poster_url}" Width="130" Height="200" Stretch="UniformToFill" VerticalAlignment="Top" RenderOptions.BitmapScalingMode="HighQuality" Grid.Column="0"/>
                                                <StackPanel Grid.Column="1" Margin="20,0,0,0" VerticalAlignment="Top">
                                                    <TextBlock Text="{Binding title}" FontSize="18" FontWeight="Bold" Margin="0,0,0,5" TextWrapping="Wrap" Foreground="White"/>
                                                    <TextBlock Text="{Binding genres}" FontSize="13" Margin="0,0,0,10" TextWrapping="Wrap" Foreground="#33FFCC"/>
                                                    <TextBlock Text="{Binding description}" FontSize="13" MaxHeight="100" TextWrapping="Wrap" Margin="0,0,0,15" Opacity="0.8" Foreground="#CCCCCC"/>
                                                    <Button Content="▶ СМОТРЕТЬ" Width="120" Height="30" Click="btnWatch_Click" Cursor="Hand" Background="#33FFCC" Foreground="#0A0A1F" FontWeight="Bold"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <Button Content="Закрыть" Click="btnClose_Click" Padding="15,8" HorizontalAlignment="Right" Width="100" Height="35" Margin="0,20,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
            <Button Content="✕" HorizontalAlignment="Right" VerticalAlignment="Top" Click="btnClose_Click" Background="Transparent" Foreground="White" BorderBrush="Transparent" FontSize="18" Width="30" Height="30" Cursor="Hand"/>
        </Grid>
    </Border>
</Window>