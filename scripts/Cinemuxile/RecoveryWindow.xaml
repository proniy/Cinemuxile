<Window x:Class="Курсач.RecoveryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Восстановление пароля" Height="250" Width="400"
        WindowStartupLocation="CenterOwner"
        Background="Transparent"
        WindowStyle="None"
        AllowsTransparency="True"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <!-- Основной контейнер с границей -->
    <Border BorderBrush="#33FFCC" BorderThickness="2" CornerRadius="20" Background="#000010">
        <Grid>
            <!-- Верхняя панель с заголовком и кнопками -->
            <DockPanel Height="48" VerticalAlignment="Top" Background="#000010"
                        MouseLeftButtonDown="TitleBar_MouseLeftButtonDown" Margin="10,10,10,0">
                <TextBlock Text="Восстановление пароля"
                           Foreground="#33FFCC"
                           FontSize="18"
                           VerticalAlignment="Center"
                           Margin="10 0 0 0"/>
                <!-- Кнопки управления -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="_"
                            Width="40"
                            Height="40"
                            Background="#000010"
                            Foreground="#33FFCC"
                            BorderBrush="#33FFCC"
                            BorderThickness="1"
                            FontSize="16"
                            Click="Minimize_Click"
                            Margin="0 0 5 0"
                            Padding="0"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"/>
                    <Button Content="X"
                            Width="40"
                            Height="40"
                            Background="#000010"
                            Foreground="#33FFCC"
                            BorderBrush="#33FFCC"
                            BorderThickness="1"
                            FontSize="16"
                            Click="Close_Click"
                            Padding="0"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"/>
                </StackPanel>
            </DockPanel>

            <!-- Основной контент -->
            <StackPanel Margin="20,58,20,20">
                <!-- Подсказка -->
                <Label Content="Введите ваш логин, email или телефон:"
                       Foreground="#33FFCC"
                       Margin="0 0 0 5"/>

                <!-- Поле ввода -->
                <TextBox x:Name="txtLogin"
                         Background="#000010"
                         Foreground="#33FFCC"
                         BorderBrush="#33FFCC"
                         BorderThickness="1"
                         Padding="5"
                         Margin="0 0 0 10"/>

                <!-- Кнопка восстановления -->
                <Button Content="Восстановить"
                        Width="120"
                        Height="30"
                        Background="#000010"
                        Foreground="#33FFCC"
                        BorderBrush="#33FFCC"
                        BorderThickness="1"
                        Click="Recover_Click"
                        Margin="0 20 0 0"
                        HorizontalAlignment="Center"
                        Padding="5"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>