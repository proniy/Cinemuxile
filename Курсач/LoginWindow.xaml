<Window x:Class="Курсач.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Вход" Height="320" Width="400"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        WindowStyle="None"
        AllowsTransparency="True"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">
    <!-- Основной контейнер с границей -->
    <Border BorderBrush="#33FFCC" BorderThickness="2" CornerRadius="20" Background="#000010">
        <Grid>
            <!-- Верхняя панель с заголовком и кнопками -->
            <DockPanel Height="42" VerticalAlignment="Top" Background="#000010"
                        MouseLeftButtonDown="TitleBar_MouseLeftButtonDown" Margin="10,5,10,0">
                <TextBlock Text="Вход"
                           Foreground="#33FFCC"
                           FontSize="18"
                           VerticalAlignment="Center"
                           Margin="10 0 0 0"/>
                <!-- Кнопки управления -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="_"
                            Width="40"
                            Height="40"
                            Background="#000010"
                            Foreground="#33FFCC"
                            BorderBrush="#33FFCC"
                            BorderThickness="1"
                            FontSize="16"
                            Click="Minimize_Click"
                            Margin="0 0 5 0"
                            Padding="0"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"/>
                    <Button Content="X"
                            Width="40"
                            Height="40"
                            Background="#000010"
                            Foreground="#33FFCC"
                            BorderBrush="#33FFCC"
                            BorderThickness="1"
                            FontSize="16"
                            Click="Close_Click"
                            Padding="0"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"/>
                </StackPanel>
            </DockPanel>

            <!-- Основной контент -->
            <StackPanel Margin="20,40,20,20">
                <!-- Логин -->
                <Label Content="Логин/Email/Телефон"
                       Foreground="#33FFCC"
                       Margin="0 0 0 5"/>
                <TextBox x:Name="txtLogin"
                         Background="#000010"
                         Foreground="#33FFCC"
                         BorderBrush="#33FFCC"
                         BorderThickness="1"
                         Padding="5"
                         Margin="0 0 0 10"/>
                <!-- Пароль -->
                <Label Content="Пароль"
                       Foreground="#33FFCC"
                       Margin="0 0 0 5"/>
                <PasswordBox x:Name="txtPassword"
                             Background="#000010"
                             Foreground="#33FFCC"
                             BorderBrush="#33FFCC"
                             BorderThickness="1"
                             Padding="5"
                             Margin="0 0 0 10"/>
                <!-- Чекбокс "Запомнить меня" -->
                <CheckBox x:Name="chkRememberMe"
                          Content="Запомнить логин/пароль"
                          Foreground="#33FFCC"
                          Background="#000010"
                          Margin="0 0 0 15"
                          VerticalAlignment="Center"
                          Checked="RememberMe_Checked"
                          Unchecked="RememberMe_Unchecked"/>
                <!-- Кнопка входа -->
                <Button Content="Войти"
                        Width="100"
                        Height="30"
                        Background="#000010"
                        Foreground="#33FFCC"
                        BorderBrush="#33FFCC"
                        BorderThickness="1"
                        Click="Login_Click"
                        Margin="0 10 0 0"
                        HorizontalAlignment="Center"
                        Padding="5"/>
                <!-- Регистрация и восстановление -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0 15 0 0">
                    <Button Content="Регистрация"
                            Width="100"
                            Height="30"
                            Background="#000010"
                            Foreground="#33FFCC"
                            BorderBrush="#33FFCC"
                            BorderThickness="1"
                            Click="Register_Click"
                            Padding="5"/>
                    <TextBlock Text=" | " Margin="5 0" Foreground="#33FFCC"/>
                    <Button Content="Забыли пароль?"
                            Width="130"
                            Height="30"
                            Background="#000010"
                            Foreground="#33FFCC"
                            BorderBrush="#33FFCC"
                            BorderThickness="1"
                            Click="Recover_Click"
                            Padding="5"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</Window>