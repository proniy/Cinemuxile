<Window x:Class="Курсач.RegistrationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Регистрация" Height="400" Width="400"
        WindowStartupLocation="CenterOwner"
        Background="Transparent"
        WindowStyle="None"
        AllowsTransparency="True"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <!-- Основной контейнер с границей -->
    <Border BorderBrush="#33FFCC" BorderThickness="2" CornerRadius="20" Background="#000010">
        <Grid>
            <!-- Верхняя панель с заголовком и кнопками -->
            <DockPanel Height="43" VerticalAlignment="Top" Background="#000010"
                        MouseLeftButtonDown="TitleBar_MouseLeftButtonDown" Margin="10,10,10,0">
                <TextBlock Text="Регистрация"
                           Foreground="#33FFCC"
                           FontSize="18"
                           VerticalAlignment="Center"
                           Margin="10 0 0 0"/>
                <!-- Кнопки управления -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="_"
                            Width="40"
                            Height="40"
                            Background="#000010"
                            Foreground="#33FFCC"
                            BorderBrush="#33FFCC"
                            BorderThickness="1"
                            FontSize="16"
                            Click="Minimize_Click"
                            Margin="0 0 5 0"
                            Padding="0"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"/>
                    <Button Content="X"
                            Width="40"
                            Height="40"
                            Background="#000010"
                            Foreground="#33FFCC"
                            BorderBrush="#33FFCC"
                            BorderThickness="1"
                            FontSize="16"
                            Click="Close_Click"
                            Padding="0"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"/>
                </StackPanel>
            </DockPanel>

            <!-- Основной контент -->
            <StackPanel Margin="20,40,20,20">
                <!-- Логин -->
                <Label Content="Логин"
                       Foreground="#33FFCC"
                       Margin="0 0 0 5"/>
                <TextBox x:Name="txtUsername"
                         Background="#000010"
                         Foreground="#33FFCC"
                         BorderBrush="#33FFCC"
                         BorderThickness="1"
                         Padding="5"
                         Margin="0 0 0 10"
                         />

                <!-- Email -->
                <Label Content="Email"
                       Foreground="#33FFCC"
                       Margin="0 0 0 5"/>
                <TextBox x:Name="txtEmail"
                         Background="#000010"
                         Foreground="#33FFCC"
                         BorderBrush="#33FFCC"
                         BorderThickness="1"
                         Padding="5"
                         Margin="0 0 0 10"
                         />

                <!-- Телефон -->
                <Label Content="Телефон"
                       Foreground="#33FFCC"
                       Margin="0 0 0 5"/>
                <TextBox x:Name="txtPhone"
                         Background="#000010"
                         Foreground="#33FFCC"
                         BorderBrush="#33FFCC"
                         BorderThickness="1"
                         Padding="5"
                         Margin="0 0 0 10"/>

                <!-- Пароль -->
                <Label Content="Пароль"
                       Foreground="#33FFCC"
                       Margin="0 0 0 5"/>
                <PasswordBox x:Name="txtPassword"
                             Background="#000010"
                             Foreground="#33FFCC"
                             BorderBrush="#33FFCC"
                             BorderThickness="1"
                             Padding="5"
                             Margin="0 0 0 10"
                             />

                <!-- Кнопка регистрации -->
                <Button Content="Зарегистрироваться"
                        Width="150"
                        Height="30"
                        Background="#000010"
                        Foreground="#33FFCC"
                        BorderBrush="#33FFCC"
                        BorderThickness="1"
                        Click="Register_Click"
                        Margin="0 20 0 0"
                        HorizontalAlignment="Center"
                        Padding="5"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>