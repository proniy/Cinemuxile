<Window x:Class="Курсач.AdminWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Панель администратора" Height="800" Width="1200"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        WindowStyle="None"
        AllowsTransparency="True"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">
    <!-- Основной контейнер с границей -->
    <Border x:Name="mainBorder" BorderBrush="#33FFCC" BorderThickness="2"  Background="#000010">
        <Grid>
            <!-- Верхняя панель с заголовком и кнопками -->
            <DockPanel x:Name="dockPanelHeader" Height="40" VerticalAlignment="Top" Background="#000010"
                        MouseLeftButtonDown="TitleBar_MouseLeftButtonDown" Margin="10,10,10,0">
                <TextBlock x:Name="txtWindowTitle" Text="Панель администратора"
                           Foreground="#33FFCC"
                           FontSize="18"
                           VerticalAlignment="Center"
                           Margin="10 0 0 0"/>
                <!-- Кнопки управления темами -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <!-- Выпадающий список тем -->
                    <ComboBox x:Name="cmbThemes" 
                              Width="150"
                              Background="#000010"
                              Foreground="#33FFCC"
                              BorderBrush="#33FFCC"
                              BorderThickness="1"
                              SelectionChanged="cmbThemes_SelectionChanged"
                              Margin="0,0,10,0">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="15" Height="15" Background="{Binding BackgroundColor}" Margin="0,0,5,0"/>
                                    <TextBlock Text="{Binding Name}" Foreground="#33FFCC"/>
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <!-- Кнопка переключения темы -->
                    <Button x:Name="btnToggleTheme" Content="🌙"
                            Width="40"
                            Height="40"
                            Background="#000010"
                            Foreground="#33FFCC"
                            BorderBrush="#33FFCC"
                            BorderThickness="1"
                            Click="ToggleTheme_Click"
                            Margin="0,0,5,0"
                            Padding="0"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"/>
                    <!-- Кнопка создания новой темы -->
                    <Button x:Name="btnCreateTheme" Content="+"
                            Width="40"
                            Height="40"
                            Background="#000010"
                            Foreground="#33FFCC"
                            BorderBrush="#33FFCC"
                            BorderThickness="1"
                            Click="CreateTheme_Click"
                            Margin="0,0,5,0"
                            Padding="0"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"/>
                    <!-- Кнопки окна -->
                    <Button x:Name="btnMinimize" Content="_"
                            Width="40"
                            Height="40"
                            Background="#000010"
                            Foreground="#33FFCC"
                            BorderBrush="#33FFCC"
                            BorderThickness="1"
                            FontSize="16"
                            Click="Minimize_Click"
                            Margin="0 0 5 0"
                            Padding="0"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"/>
                    <Button x:Name="btnClose" Content="X"
                            Width="40"
                            Height="40"
                            Background="#000010"
                            Foreground="#33FFCC"
                            BorderBrush="#33FFCC"
                            BorderThickness="1"
                            FontSize="16"
                            Click="Close_Click"
                            Padding="0"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"/>
                </StackPanel>
            </DockPanel>

            <!-- Основной контент -->
            <Grid Margin="0,40,0,0">
                <TabControl x:Name="tabControl" Margin="10" Background="#000010" Foreground="#33FFCC">
                    <!-- Вкладка управления пользователями -->
                    <TabItem Header="Учетные записи">
                        <Grid Margin="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Orientation="Horizontal" Grid.Row="0">
                                <TextBox x:Name="txtUserFilter" Width="300" Background="#000010" Foreground="#33FFCC" BorderBrush="#33FFCC" TextChanged="UserFilter_TextChanged"/>
                                <Button Content="Сбросить" Click="ResetUserFilter_Click" Margin="5"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Grid.Row="1">
                                <Button Content="Добавить" Click="AddUser_Click" Margin="5"/>
                                <Button Content="Редактировать" Click="EditUser_Click" Margin="5"/>
                                <Button Content="Удалить" Click="DeleteUser_Click" Margin="5"/>
                            </StackPanel>

                            <DataGrid x:Name="dgUsers" Grid.Row="2" Background="#000010" Foreground="#33FFCC" BorderBrush="#33FFCC"
                                      AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Логин" Binding="{Binding username}" Width="*"/>
                                    <DataGridTextColumn Header="Email" Binding="{Binding email}" Width="2*"/>
                                    <DataGridTextColumn Header="Телефон" Binding="{Binding phone}" Width="*"/>
                                    <DataGridTextColumn Header="Роль" Binding="{Binding role}" Width="100"/>
                                    <DataGridCheckBoxColumn Header="Активен" Binding="{Binding is_active}" Width="80"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </TabItem>
                    <!-- Вкладка управления видео -->
                    <TabItem Header="Видеоматериалы" Background="#000010"
                             Foreground="#33FFCC">
                        <Grid Margin="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <!-- Панель фильтрации -->
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0 0 0 5">
                                <Label Content="Фильтр по названию"
                                       Foreground="#33FFCC"
                                       Margin="0 0 5 0"
                                       VerticalAlignment="Center"/>
                                <TextBox x:Name="txtVideoFilter" Width="300"
                                         Background="#000010"
                                         Foreground="#33FFCC"
                                         BorderBrush="#33FFCC"
                                         BorderThickness="1"
                                         Padding="5"
                                         Margin="0 0 5 0"
                                         TextChanged="VideoFilter_TextChanged"/>
                                <Button x:Name="btnResetVideoFilter" Content="Сбросить"
                                        Width="100"
                                        Background="#000010"
                                        Foreground="#33FFCC"
                                        BorderBrush="#33FFCC"
                                        BorderThickness="1"
                                        Click="ResetVideoFilter_Click"
                                        Margin="5 0"/>
                            </StackPanel>
                            <!-- Кнопки управления -->
                            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0 0 0 10">
                                <Button Content="Добавить видео"
                                        Width="120"
                                        Background="#000010"
                                        Foreground="#33FFCC"
                                        BorderBrush="#33FFCC"
                                        BorderThickness="1"
                                        Click="AddVideo_Click"
                                        Margin="5"/>
                                <Button Content="Удалить видео"
                                        Width="120"
                                        Background="#000010"
                                        Foreground="#33FFCC"
                                        BorderBrush="#33FFCC"
                                        BorderThickness="1"
                                        Click="DeleteVideo_Click"
                                        Margin="5"/>
                            </StackPanel>
                            <!-- Таблица видео -->
                            <DataGrid x:Name="dgVideos" Grid.Row="2"
                                      Background="#000010"
                                      Foreground="#33FFCC"
                                      BorderBrush="#33FFCC"
                                      BorderThickness="1"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      SelectionMode="Single"
                                      HeadersVisibility="Column">
                                <DataGrid.ColumnHeaderStyle>
                                    <Style TargetType="DataGridColumnHeader">
                                        <Setter Property="Background" Value="#000010"/>
                                        <Setter Property="Foreground" Value="#33FFCC"/>
                                    </Style>
                                </DataGrid.ColumnHeaderStyle>
                                <DataGrid.CellStyle>
                                    <Style TargetType="DataGridCell">
                                        <Setter Property="Background" Value="#000010"/>
                                        <Setter Property="Foreground" Value="#33FFCC"/>
                                        <Setter Property="BorderBrush" Value="#33FFCC"/>
                                    </Style>
                                </DataGrid.CellStyle>
                                <DataGrid.RowStyle>
                                    <Style TargetType="DataGridRow">
                                        <Setter Property="Background" Value="#000010"/>
                                        <Setter Property="Foreground" Value="#33FFCC"/>
                                        <Setter Property="BorderBrush" Value="#33FFCC"/>
                                    </Style>
                                </DataGrid.RowStyle>
                                <DataGrid.Columns>
                                    <!-- Колонка с мини-постером -->
                                    <DataGridTemplateColumn Header="Постер" Width="80">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Image Source="{Binding poster_url}"
                                                       Width="70" Height="100"
                                                       Stretch="UniformToFill"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Название" Binding="{Binding title}" Width="*"/>
                                    <DataGridTextColumn Header="Тип" Binding="{Binding type}" Width="100"/>
                                    <DataGridTextColumn Header="Год" Binding="{Binding release_year}" Width="80"/>
                                    <DataGridTextColumn Header="Рейтинг" Binding="{Binding rating}" Width="80"/>
                                    <DataGridTextColumn Header="Жанры" Binding="{Binding genres}" Width="200"/>
                                    <!-- Скрытые поля -->
                                    <DataGridTextColumn Header="Путь к файлу" Binding="{Binding file_path}" Visibility="Collapsed"/>
                                    <DataGridTextColumn Header="Описание" Binding="{Binding description}" Visibility="Collapsed"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </TabItem>
                    <TabItem Header="Техподдержка" Background="#000010"
         Foreground="#33FFCC">
                        <Grid Margin="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <!-- Панель фильтрации -->
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0 0 0 5">
                                <Label Content="Фильтр по тексту или пользователю"
                   Foreground="#33FFCC"
                   Margin="0 0 5 0"
                   VerticalAlignment="Center"/>
                                <TextBox x:Name="txtSupportFilter" Width="300"
                     Background="#000010"
                     Foreground="#33FFCC"
                     BorderBrush="#33FFCC"
                     BorderThickness="1"
                     Padding="5"
                     Margin="0 0 5 0"
                     TextChanged="SupportFilter_TextChanged"/>
                                <Button x:Name="btnResetSupportFilter" Content="Сбросить"
                    Width="100"
                    Background="#000010"
                    Foreground="#33FFCC"
                    BorderBrush="#33FFCC"
                    BorderThickness="1"
                    Click="ResetSupportFilter_Click"
                    Margin="5 0"/>
                            </StackPanel>
                            <!-- Панель фильтрации и сортировки -->
                            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0 0 0 10">
                                <!-- Чекбокс "Показывать выполненные" -->
                                <CheckBox x:Name="chkShowResolved"
                      Content="Показывать выполненные"
                      Foreground="#33FFCC"
                      Background="#000010"
                      BorderBrush="#33FFCC"
                      VerticalAlignment="Center"
                      HorizontalAlignment="Left"
                      Margin="0 0 10 0"
                      Checked="SupportFilter_Changed"
                      Unchecked="SupportFilter_Changed"/>
                                <!-- Выпадающий список категорий -->
                                <ComboBox x:Name="cmbCategoryFilter"
                      Width="200"
                      Background="#000010"
                      Foreground="#33FFCC"
                      BorderBrush="#33FFCC"
                      BorderThickness="1"
                      SelectionChanged="SupportFilter_Changed"
                      Margin="0 0 10 0">
                                    <ComboBoxItem Content="Все категории" IsSelected="True"/>
                                    <ComboBoxItem Content="Технические проблемы"/>
                                    <ComboBoxItem Content="Ошибка в контенте"/>
                                    <ComboBoxItem Content="Вопрос по аккаунту"/>
                                    <ComboBoxItem Content="Предложения"/>
                                </ComboBox>
                            </StackPanel>
                            <!-- Таблица обращений -->
                            <DataGrid x:Name="dgSupportTickets" Grid.Row="3"
                  Background="#000010"
                  Foreground="#33FFCC"
                  BorderBrush="#33FFCC"
                  BorderThickness="1"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  HeadersVisibility="Column">
                                <DataGrid.ColumnHeaderStyle>
                                    <Style TargetType="DataGridColumnHeader">
                                        <Setter Property="Background" Value="#000010"/>
                                        <Setter Property="Foreground" Value="#33FFCC"/>
                                    </Style>
                                </DataGrid.ColumnHeaderStyle>
                                <DataGrid.CellStyle>
                                    <Style TargetType="DataGridCell">
                                        <Setter Property="Background" Value="#000010"/>
                                        <Setter Property="Foreground" Value="#33FFCC"/>
                                        <Setter Property="BorderBrush" Value="#33FFCC"/>
                                    </Style>
                                </DataGrid.CellStyle>
                                <DataGrid.RowStyle>
                                    <Style TargetType="DataGridRow">
                                        <Setter Property="Background" Value="#000010"/>
                                        <Setter Property="Foreground" Value="#33FFCC"/>
                                        <Setter Property="BorderBrush" Value="#33FFCC"/>
                                    </Style>
                                </DataGrid.RowStyle>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Пользователь" Binding="{Binding username}" Width="150"/>
                                    <!-- Новая колонка для текста запроса -->
                                    <DataGridTemplateColumn Header="Текст запроса" Width="300">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding request_text}"
                                       TextWrapping="Wrap"
                                       MaxWidth="300"
                                       Foreground="#33FFCC"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Категория" Binding="{Binding category}" Width="200"/>
                                    <DataGridTextColumn Header="Дата" Binding="{Binding created_at, StringFormat=dd.MM.yyyy HH:mm}" Width="150"/>
                                    <DataGridCheckBoxColumn Header="Выполнено" Binding="{Binding is_resolved}" Width="80"/>
                                    <DataGridTemplateColumn Header="Действия" Width="120">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="Изменить статус" 
                                    Click="ChangeStatus_Click" 
                                    Tag="{Binding ticket_id}"
                                    Background="#000010"
                                    Foreground="#33FFCC"
                                    BorderBrush="#33FFCC"
                                    BorderThickness="1"
                                    Width="110"
                                    Margin="5"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Grid>
        </Grid>
    </Border>
</Window>