<Window x:Class="Курсач.SupportRequestWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Запрос в техподдержку" Height="300" Width="400"
        WindowStartupLocation="CenterScreen"
        Background="#000010"
        BorderBrush="#33FFCC"
        BorderThickness="2"
        WindowStyle="None"
        AllowsTransparency="True">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <TextBlock Text="Новый запрос" 
                   FontSize="18" 
                   Foreground="#33FFCC"
                   HorizontalAlignment="Center"
                   Margin="0 0 0 10"/>

        <!-- Категория -->
        <Label Content="Категория запроса" Foreground="#33FFCC" Margin="0,0,0,172" RenderTransformOrigin="0.5,0.5" Grid.Row="1"/>
        <ComboBox x:Name="cmbCategory" 
                  ItemsSource="{Binding Categories}"
                  SelectedIndex="0"
                  Margin="0,32,0,136"
                  Background="#000010"
                  Foreground="#33FFCC"
                  BorderBrush="#33FFCC"
                  BorderThickness="1"
                  Grid.Row="1"/>

        <!-- Текст запроса -->
        <Label Content="Описание проблемы" Foreground="#33FFCC" Grid.Row="1" Margin="0,73,0,106"/>
        <TextBox x:Name="txtRequest" 
                 AcceptsReturn="True" 
                 TextWrapping="Wrap"
                 Margin="0,103,0,0"
                 Background="#000010"
                 Foreground="#33FFCC"
                 BorderBrush="#33FFCC"
                 BorderThickness="1"
                 Grid.Row="1"/>

        <!-- Кнопки -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Grid.Row="5">
            <Button Content="Отправить" 
                    Width="100"
                    Background="#000010"
                    Foreground="#33FFCC"
                    BorderBrush="#33FFCC"
                    BorderThickness="1"
                    Click="Submit_Click"
                    Margin="5"/>
            <Button Content="Отмена" 
                    Width="100"
                    Background="#000010"
                    Foreground="#33FFCC"
                    BorderBrush="#33FFCC"
                    BorderThickness="1"
                    Click="Cancel_Click"
                    Margin="5"/>
        </StackPanel>
    </Grid>
</Window>